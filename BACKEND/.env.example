# FWA Risk Investigator — optional environment configuration.
# Copy to .env (or set in the shell) before starting the backend.

# ---- LLM explanation layer (Phase 3) -----------------------------------
# Required to enable POST /api/claims/explain and POST /api/providers/explain.
# Without a key the endpoints fail clearly with HTTP 503 — no fabricated output.
# Keys are NEVER hardcoded; the backend reads them from the environment only.
FWA_LLM_API_KEY=
FWA_LLM_BASE_URL=https://api.openai.com/v1
FWA_LLM_MODEL=gpt-4o-mini

# ---- CORS (optional override) -------------------------------------------
# FWA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
